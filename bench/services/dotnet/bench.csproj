<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Chiseled images carry no ICU; nothing here needs culture data. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>bench</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Cloud.PubSub.V1" Version="3.40.0" />
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
  </ItemGroup>
</Project>
