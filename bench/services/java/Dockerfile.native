FROM maven:3.10-eclipse-temurin-25 AS build
WORKDIR /src
COPY pom.xml ./
RUN mvn -q -B dependency:go-offline
COPY src ./src
RUN mvn -q -B -o package

# GraalVM native image of the same jar. The gRPC, Netty and Google client
# libraries ship their own native-image metadata in META-INF/native-image.
FROM ghcr.io/graalvm/native-image-community:25 AS native
WORKDIR /src
COPY --from=build /src/target/bench.jar ./
COPY --from=build /src/target/lib ./lib
RUN native-image --no-fallback -O2 --enable-url-protocols=https \
      -cp "bench.jar:lib/*" -o /src/bench bench.Main

# distroless/base: glibc, OpenSSL and CA certificates.
FROM gcr.io/distroless/base-debian13:nonroot
COPY --from=native /src/bench /app
USER 65532:65532
ENTRYPOINT ["/app"]
