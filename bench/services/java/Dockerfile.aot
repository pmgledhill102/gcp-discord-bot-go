FROM maven:3.10-eclipse-temurin-25 AS build
WORKDIR /src
COPY pom.xml ./
RUN mvn -q -B dependency:go-offline
COPY src ./src
RUN mvn -q -B -o package

# JDK 25 AOT cache (JEPs 483, 514, 515): a training run records which classes
# were loaded and linked, and which methods were hot, and the runtime maps that
# in instead of rediscovering it. The cache is only valid for the exact JVM that
# made it, so the training runs in the runtime image itself (the root-tagged
# variant, so it can write /app; the final USER drops back to non-root).
# Distroless publishes no version tags; latest is the root-user variant of :nonroot.
# hadolint ignore=DL3007
FROM gcr.io/distroless/java25-debian13:latest
WORKDIR /app
COPY --from=build /src/target/bench.jar ./
COPY --from=build /src/target/lib ./lib
RUN ["java", "-XX:AOTCacheOutput=/app/bench.aot", "-jar", "/app/bench.jar", "--train"]
USER 65532:65532
ENTRYPOINT ["java", "-XX:AOTCache=/app/bench.aot", "-jar", "/app/bench.jar"]
